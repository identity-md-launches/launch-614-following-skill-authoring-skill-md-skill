# Copy this file on the host and fill in real values. Never commit real values.
TELEGRAM_BOT_TOKEN=replace-me

# Comma-separated chat ids the bot answers; empty allows every chat.
ALLOWED_CHAT_IDS=

# Port for the status page.
PORT=8080

# Inbound rate limit: commands per window per chat.
RATE_LIMIT=5
RATE_WINDOW_MS=60000
